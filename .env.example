# ---------------------------------------------------------------------------
# Required in production
# ---------------------------------------------------------------------------

# Postgres connection. Locally, `npm run db:local` starts one on this URL.
# On Railway this comes from the Postgres service (${{Postgres.DATABASE_URL}}).
DATABASE_URL="postgresql://spine:spine@localhost:5433/spine"

# Public URL of the app, used in invitation links, emails and Slack/Teams messages.
SPINE_APP_URL="http://localhost:3000"

# Encrypts integration secrets (Slack and Teams webhook URLs) at rest. At least 32 characters,
# random, and kept the same across deploys: changing it disconnects saved webhooks.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SPINE_ENCRYPTION_KEY=""

# Where uploaded attachments are stored (a Railway volume in production, for example /data/uploads).
UPLOAD_DIR="./uploads"

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Anthropic API. Without these, AI features show a calm "AI isn't set up" line and everything
# else works. Admin > AI & health shows whether calls are succeeding.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5-5"

# Timezone used for dates, month boundaries and the digest schedule.
SPINE_TIMEZONE="Europe/London"

# Email through Resend (resend.com). Empty prints emails to the console; invitation links are
# always shown to the admin who sent them, so Spine works without email.
RESEND_API_KEY=""
EMAIL_FROM="Spine <spine@yourcompany.com>"

# "1" lets anyone create a new organisation at /signup. Off by default: organisations are
# created with `npm run bootstrap` and people join by invitation.
SPINE_ALLOW_SIGNUP=""

# ---------------------------------------------------------------------------
# Development, demos and tests only
# ---------------------------------------------------------------------------

# Fixed "now" for the demo data. Ignored in production unless SPINE_ALLOW_FIXED_CLOCK=1.
SPINE_TODAY="2026-10-07T10:00:00"
SPINE_ALLOW_FIXED_CLOCK=""

# Password given to every demo person by `npm run seed` (emails are first.last@demo.spine.test).
SPINE_DEMO_PASSWORD="spine-demo-password"

# The seed refuses to run when NODE_ENV=production unless this is "1" (it wipes the database).
SPINE_ALLOW_DEMO_SEED=""

# "1" sends the session cookie without the Secure flag in production, for a local production
# build served over plain http. Never set this on a real deployment.
SPINE_INSECURE_COOKIES=""

# "1" returns stored AI responses so screenshots are stable. Ignored in production.
SPINE_AI_FIXTURES=""
