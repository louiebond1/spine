# Postgres connection. Locally, `npm run db:local` starts one on this URL.
DATABASE_URL="postgresql://spine:spine@localhost:5433/spine"

# Anthropic API, used for the AI review and the build plan.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5-5"

# Fixed "now" for demos and visual checks. Leave empty to use the real time.
SPINE_TODAY="2026-10-07T10:00:00"

# Timezone used for dates, month boundaries and the digest schedule.
SPINE_TIMEZONE="Europe/London"

# Slack incoming webhook for the daily Pulse digest. Empty logs the digest to the console.
SLACK_WEBHOOK_URL=""

# Public URL of the app, used for links in the Slack digest.
SPINE_APP_URL="http://localhost:3000"

# Where uploaded attachments are stored (a Railway volume in production).
UPLOAD_DIR="./uploads"

# Dev and test only: return stored AI responses for known ideas so screenshots are stable.
SPINE_AI_FIXTURES=""

# Email notifications through Resend (resend.com). Empty logs emails to the console instead.
RESEND_API_KEY=""
# Sender address, on a domain verified in Resend.
EMAIL_FROM="Spine <spine@yourcompany.com>"
