generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Organisations and identity ----------

/// One customer company. Every tenant-owned record carries orgId (see src/server/tenant.ts).
model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users       User[]
  invitations Invitation[]
}

enum UserStatus {
  ACTIVE
  INVITED
  DEACTIVATED
}

/// A signed-in browser. Only a SHA-256 hash of the cookie token is stored.
model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String
  expiresAt  DateTime
  lastSeenAt DateTime
  userAgent  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// An invitation (or access reset) link. Only a hash of the token is stored; links expire.
model Invitation {
  id                     String    @id @default(cuid())
  orgId                  String
  email                  String
  name                   String
  isChampion             Boolean   @default(false)
  isAdmin                Boolean   @default(false)
  isPublishingSpecialist Boolean   @default(false)
  tokenHash              String    @unique
  invitedById            String?
  /// Set when the link resets access for an existing person rather than inviting a new one.
  userId                 String?
  expiresAt              DateTime
  acceptedAt             DateTime?
  revokedAt              DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, email])
}

/// Fixed-window counters for login and invite attempts.
model RateLimit {
  key         String   @id
  count       Int
  windowStart DateTime
}

/// Who changed what in administration (roles, people, rules, integrations, settings).
model AuditLog {
  id         String   @id @default(cuid())
  orgId      String
  actorId    String?
  action     String
  targetType String
  targetId   String?
  detail     String?
  at         DateTime @default(now())

  @@index([orgId, at])
}

/// One row per AI request, for the health panel and the monthly limit. Never holds prompt text.
model AiCall {
  id         String   @id @default(cuid())
  orgId      String?
  feature    String
  ok         Boolean
  errorKind  String? // credit, auth, rate_limit, overloaded, invalid_output, not_configured, limit_reached, other
  durationMs Int
  at         DateTime @default(now())

  @@index([orgId, at])
  @@index([at])
}

// ---------- People ----------

model User {
  id                     String         @id @default(cuid())
  orgId                  String
  name                   String
  initials               String
  isChampion             Boolean        @default(false)
  isAdmin                Boolean        @default(false)
  isPublishingSpecialist Boolean        @default(false)
  /// Sign-in address, unique across Spine (one person, one organisation).
  email                  String?        @unique
  passwordHash           String?
  status                 UserStatus     @default(ACTIVE)
  lastLoginAt            DateTime?
  /// Identity mapping for Slack mentions in notifications (a Slack member ID such as U012AB3CD).
  slackUserId            String?
  preferences            Json? // notification choices (src/lib/preferences.ts)
  notifications          Notification[]
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  questionsAsked     Question[]        @relation("QuestionAsker")
  questionsClaimed   Question[]        @relation("QuestionClaimer")
  questionMessages   QuestionMessage[]
  questionEvents     QuestionEvent[]
  projectsOwned      Project[]         @relation("ProjectOwner")
  projectsApproved   Project[]         @relation("ProjectApprover")
  projectsPublishing Project[]         @relation("ProjectPublisher")
  teamMemberships    TeamMember[]
  planSteps          PlanStep[]
  projectMessages    ProjectMessage[]
  projectEvents      ProjectEvent[]
  assistantThreads   AssistantThread[]
  sessions           Session[]
  checkIns           CheckIn[]
  discoveries        Discovery[]
  org                Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
}

model Topic {
  id         String    @id @default(cuid())
  orgId      String
  name       String
  archivedAt DateTime? // ADDED: "remove" hides it from pickers without breaking old questions/projects (Q19)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  questions   Question[]
  projects    Project[]
  discoveries Discovery[]

  @@unique([orgId, name])
}

// ---------- Help Desk ----------

enum QuestionStatus {
  UNCLAIMED
  IN_PROGRESS
  RESOLVED
}

model Question {
  id              String         @id @default(cuid())
  orgId           String
  title           String
  body            String // shown as the asker's first bubble in the thread; not counted as a reply
  askerId         String // always stored; never sent to any client when isAnonymous
  isAnonymous     Boolean        @default(false)
  topicId         String
  status          QuestionStatus @default(UNCLAIMED)
  claimerId       String?
  postedAt        DateTime
  claimedAt       DateTime?
  resolvedAt      DateTime?
  /// Spine's instant suggested answer, drafted from past resolved threads.
  aiAnswer        String?
  aiAnswerSources String[]       @default([])
  aiAnswerAt      DateTime?
  /// Threads are private to the asker and the claimer. Only an answer the asker agreed to
  /// share becomes company knowledge, and only this summary is shown: never the chat or files.
  answerSummary   String?
  sharedAt        DateTime?
  sharedById      String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  asker    User              @relation("QuestionAsker", fields: [askerId], references: [id])
  claimer  User?             @relation("QuestionClaimer", fields: [claimerId], references: [id])
  topic    Topic             @relation(fields: [topicId], references: [id])
  messages QuestionMessage[]
  events   QuestionEvent[]

  @@index([orgId, status, postedAt])
  @@index([claimerId, resolvedAt])
  @@index([orgId, sharedAt])
}

model QuestionMessage {
  id         String   @id @default(cuid())
  questionId String
  authorId   String
  body       String
  sentAt     DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  question    Question     @relation(fields: [questionId], references: [id], onDelete: Cascade)
  author      User         @relation(fields: [authorId], references: [id])
  attachments Attachment[]

  @@index([questionId, sentAt])
}

model Attachment {
  id         String   @id @default(cuid())
  messageId  String
  fileName   String
  sizeBytes  Int
  storageKey String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  message QuestionMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
}

enum QuestionEventType {
  POSTED
  CLAIMED
  REPLIED
  REPLIED_WITH_FILE
  RESOLVED
  REOPENED
}

model QuestionEvent {
  id         String            @id @default(cuid())
  questionId String
  type       QuestionEventType
  actorId    String
  at         DateTime
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  actor    User     @relation(fields: [actorId], references: [id])

  @@index([questionId, at])
}

// ---------- Ideas & Projects ----------

enum BuildPath {
  APP
  COWORK_NATIVE
}

enum Difficulty {
  EASY
  MODERATE
  HARD
}

enum ProjectStage {
  IDEA // draft, including returned ideas
  APPROVAL
  RECRUITING
  BUILDING
  PUBLISHING
  LIVE
}

enum PlanStatus {
  NONE
  GENERATING
  READY
  FAILED
}

model Project {
  id                   String       @id @default(cuid())
  orgId                String
  title                String
  problem              String
  whoBenefits          String
  topicId              String
  /// Kept for history. Spine 2.0 has one lifecycle; new initiatives are APP.
  buildPath            BuildPath    @default(APP)
  teamSize             Int
  hoursPerWeek         Int
  lengthWeeks          Int
  difficulty           Difficulty
  targetDate           DateTime
  ownerId              String
  stage                ProjectStage @default(IDEA)
  submittedAt          DateTime?
  autoApproveAt        DateTime?
  approvedAt           DateTime?
  approvedById         String? // null + approvedAt set = auto-approved
  returnNote           String?
  publisherId          String?
  publishingAssignedAt DateTime? // ADDED: tie-break "assigned least recently" (rule I-11)
  buildCompletedAt     DateTime? // ADDED: Cowork-native needs to know it already built when in Approval
  liveAt               DateTime?
  lastActivityAt       DateTime
  planStatus           PlanStatus   @default(NONE) // ADDED
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  topic              Topic            @relation(fields: [topicId], references: [id])
  owner              User             @relation("ProjectOwner", fields: [ownerId], references: [id])
  approvedBy         User?            @relation("ProjectApprover", fields: [approvedById], references: [id])
  publisher          User?            @relation("ProjectPublisher", fields: [publisherId], references: [id])
  aiReview           AiReview?        @relation("ReviewOf")
  relatedIn          AiReview[]       @relation("ReviewRelated")
  team               TeamMember[]
  steps              PlanStep[]
  messages           ProjectMessage[]
  events             ProjectEvent[]
  impact             ImpactLog[]
  draftSteps         DraftStep[]
  recommendations    Recommendation[]
  invites            ProjectInvite[]
  /// From "Shape it with Spine": concrete use cases, success measure, MVP scope, estimated hours saved a month.
  useCases           Json?
  successMetric      String?
  mvpScope           String?
  laterScope         String?
  hoursSavedEstimate Int?

  // Approval routing (snapshotted from the matching ApprovalRule when the idea enters Approval)
  approvalRuleId    String?
  approverIds       String[]          @default([]) // empty means any admin
  approvalsNeeded   Int               @default(1)
  approvalBrief     Json? // Spine approval brief for approvers (never contains scores)
  approvalNudgedAt  DateTime? // approvers reminded about a stuck approval
  escalatedAt       DateTime? // stuck too long: any admin can now decide
  approvals         ProjectApproval[]
  recommendationsAt DateTime?
  assistantThreads  AssistantThread[]

  /// Link to an existing Teams or Slack channel where the team works (never created by default).
  channelUrl       String?
  /// Momentum: check-ins every N days while building; null when check-ins are off.
  checkInEveryDays Int?        @default(7)
  nextCheckInAt    DateTime?
  blockedAt        DateTime?
  blockerNote      String?
  checkIns         CheckIn[]
  discoveries      Discovery[]

  @@index([orgId, stage, autoApproveAt])
  @@index([orgId, stage, lastActivityAt])
}

model AiReview {
  id                         String   @id @default(cuid())
  projectId                  String   @unique // one current review per project; re-running replaces it
  feasibility                Int
  feasibilityReason          String
  businessValue              Int
  businessValueReason        String
  resourcingConfidence       Int
  resourcingConfidenceReason String
  originality                Int
  originalityReason          String
  relatedProjectId           String?
  raisedConcerns             Boolean // true when any score <= 5; computed on the server, never by the model
  completedAt                DateTime
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  project        Project  @relation("ReviewOf", fields: [projectId], references: [id], onDelete: Cascade)
  relatedProject Project? @relation("ReviewRelated", fields: [relatedProjectId], references: [id], onDelete: SetNull)
}

model TeamMember {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  joinedAt  DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@unique([projectId, userId])
}

model PlanStep {
  id                 String    @id @default(cuid())
  projectId          String
  title              String
  activePhrase       String // e.g. "testing supplier cases"; written by Claude, or derived for manual steps (Q24)
  assigneeId         String
  dueDate            DateTime
  done               Boolean   @default(false)
  doneAt             DateTime?
  order              Int
  generatedFromBrief Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee User    @relation(fields: [assigneeId], references: [id])

  @@index([projectId, order])
}

model ProjectMessage {
  id        String   @id @default(cuid())
  projectId String
  authorId  String? // null for system messages
  body      String
  sentAt    DateTime
  isSystem  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author  User?   @relation(fields: [authorId], references: [id])

  @@index([projectId, sentAt])
}

enum ProjectEventType {
  CREATED
  AI_REVIEWED
  SUBMITTED
  RETURNED
  APPROVED
  AUTO_APPROVED
  PARTIALLY_APPROVED // one approver of several signed off
  FAST_TRACKED // an approval rule skipped review
  APPROVAL_NUDGED // approvers reminded
  APPROVAL_ESCALATED // handed to any admin
  IDEA_MERGED // someone joined this instead of proposing a duplicate
  JOINED
  RECRUITED // team full, moved to Building
  PLAN_GENERATED
  STEP_ADDED
  STEP_EDITED
  STEP_COMPLETED
  STEP_REOPENED
  BUILD_COMPLETED
  PUBLISHER_ASSIGNED
  WENT_LIVE
  HOURS_LOGGED
  CHECKED_IN
  BLOCKED
  UNBLOCKED
  OUTCOME_VERIFIED
  CHANNEL_LINKED
}

model ProjectEvent {
  id        String           @id @default(cuid())
  projectId String
  type      ProjectEventType
  actorId   String? // null for automatic events (auto-approve, publisher assignment)
  detail    String? // e.g. step title, return note summary
  at        DateTime
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actor   User?   @relation(fields: [actorId], references: [id])

  @@index([projectId, at])
}

model ImpactLog {
  id           String    @id @default(cuid())
  projectId    String
  month        DateTime // first day of the month, 00:00
  hoursSaved   Int
  /// How the number was measured. Required for verification.
  evidence     String?
  reportedById String?
  /// Verified outcomes: confirmed by someone outside the team (an approver or admin).
  verifiedById String?
  verifiedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, month])
}

// ---------- Settings (single row) ----------

model Settings {
  id                     String    @id @default(cuid())
  orgId                  String    @unique
  approvalTimeoutDays    Int       @default(7)
  approvalNudgeDays      Int       @default(3) // remind approvers after this many days
  approvalEscalateDays   Int       @default(7) // then let any admin decide
  stalledBuildDays       Int       @default(10)
  unclaimedQuestionHours Int       @default(2)
  digestChannel          String    @default("Slack")
  digestTime             String    @default("09:00") // HH:mm
  digestWeekdaysOnly     Boolean   @default(true)
  hourlyCost             Decimal?  @db.Decimal(10, 2)
  programmeCost          Decimal?  @db.Decimal(12, 2)
  lastDigestSentOn       DateTime? // ADDED: stops the cron sending twice in one day
  opportunitiesScannedAt DateTime? // last "Spotted by Spine" scan
  /// AI requests allowed per calendar month for this organisation (0 turns AI off).
  aiMonthlyLimit         Int       @default(1000)
  /// Integration secrets, encrypted with SPINE_ENCRYPTION_KEY (src/server/crypto.ts).
  slackWebhookEnc        String?
  teamsWebhookEnc        String?
  /// Last delivery result per channel, shown in Admin > Integrations.
  slackLastAt            DateTime?
  slackLastStatus        String?
  teamsLastAt            DateTime?
  teamsLastStatus        String?
  /// Who may sign in: an email domain that new invitations must match (optional).
  allowedEmailDomain     String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
}

// ---------- Draft plan (written at proposal time, assigned when the team is complete) ----------

model DraftStep {
  id           String   @id @default(cuid())
  projectId    String
  title        String
  activePhrase String
  order        Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, order])
}

// ---------- Deprecated: Ask Spine (removed in 2.0; tables kept until a deliberate drop) ----------

model AssistantThread {
  id        String   @id @default(cuid())
  userId    String
  projectId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  project  Project?           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  messages AssistantMessage[]

  @@index([userId, projectId, updatedAt])
}

model AssistantMessage {
  id        String   @id @default(cuid())
  threadId  String
  role      String // "user" | "assistant"
  /// Plain text shown in the chat.
  text      String
  /// Full API content blocks for this turn (tool calls and results), replayed to the model.
  content   Json
  /// Proposed actions waiting for the user's confirmation.
  actions   Json     @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  thread AssistantThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
}

// ---------- Spotted by Spine: repeated Help Desk questions that should become projects ----------

enum OpportunityStatus {
  OPEN
  PROPOSED
  DISMISSED
}

model Opportunity {
  id          String            @id @default(cuid())
  orgId       String
  title       String
  problem     String
  whoBenefits String
  topicId     String?
  /// Help Desk questions that show the need.
  evidenceIds String[]
  /// Normalised key of the question cluster, so the same cluster isn't suggested twice.
  clusterKey  String
  status      OpportunityStatus @default(OPEN)
  projectId   String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([orgId, clusterKey])
}

// ---------- Deprecated: Autopilot fixes (removed in 2.0; tables kept until a deliberate drop) ----------

enum RecommendationStatus {
  OPEN
  APPLIED
  DISMISSED
  UNDONE
}

model Recommendation {
  id          String               @id @default(cuid())
  projectId   String
  /// extend_target | add_team_spot | start_with_current_team | reassign_step | reschedule_overdue | nudge_team
  kind        String
  headline    String
  reason      String
  /// Parameters for the action, validated again when applied.
  payload     Json
  status      RecommendationStatus @default(OPEN)
  appliedById String?
  appliedAt   DateTime?
  /// What to restore on undo.
  undo        Json?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, status])
}

// ---------- Invites (from "Start with Spine") ----------

enum InviteStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model ProjectInvite {
  id          String       @id @default(cuid())
  projectId   String
  userId      String
  invitedById String
  status      InviteStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId, status])
}

// ---------- Approval rules (Admin > Approvals) ----------

model ApprovalRule {
  id               String   @id @default(cuid())
  orgId            String
  name             String
  position         Int      @default(0)
  active           Boolean  @default(true)
  // Conditions: an empty list or null means "any".
  topicIds         String[] @default([])
  buildPaths       String[] @default([]) // APP, COWORK_NATIVE
  difficulties     String[] @default([]) // EASY, MODERATE, HARD
  minTotalHours    Int? // team size x hours per week x weeks, at least
  maxTotalHours    Int? // at most
  onlyWithConcerns Boolean  @default(false)
  // Outcome
  approverIds      String[] @default([]) // empty means any admin
  requireAll       Boolean  @default(false)
  autoApproveDays  Int? // null means never auto-approve
  fastTrack        Boolean  @default(false) // approve immediately, no review
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([orgId, position])
}

model ProjectApproval {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  at        DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, userId])
}

// ---------- Notifications (in-app, email, Slack) ----------

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String // approval, decision, invite, reply, step, nudge, report
  title     String
  body      String
  href      String
  readAt    DateTime?
  emailedAt DateTime?
  at        DateTime
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId, at])
}

// ---------- Monthly leadership report ----------

model LeadershipReport {
  id          String   @id @default(cuid())
  orgId       String
  month       String // yyyy-mm
  content     Json
  generatedAt DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([orgId, month])
}

// ---------- Momentum: check-ins ----------

enum CheckInStatus {
  ON_TRACK
  AT_RISK
  BLOCKED
}

model CheckIn {
  id        String        @id @default(cuid())
  projectId String
  authorId  String
  status    CheckInStatus
  note      String
  at        DateTime
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorId], references: [id])

  @@index([projectId, at])
}

// ---------- Alignment: the company AI playbook ----------

model Priority {
  id          String   @id @default(cuid())
  orgId       String
  title       String
  description String
  position    Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([orgId, position])
}

enum ToolStatus {
  APPROVED
  LIMITED
  NOT_APPROVED
}

model Tool {
  id           String     @id @default(cuid())
  orgId        String
  name         String
  purpose      String
  status       ToolStatus @default(APPROVED)
  /// What data may and may not go into it, in plain words.
  dataGuidance String
  url          String?
  position     Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([orgId, position])
}

model Guide {
  id          String   @id @default(cuid())
  orgId       String
  title       String
  body        String
  position    Int      @default(0)
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([orgId, position])
}

// ---------- Inspiration: shared discoveries ----------

model Discovery {
  id        String   @id @default(cuid())
  orgId     String
  authorId  String
  title     String
  /// What they tried and what happened.
  body      String
  toolName  String?
  topicId   String?
  projectId String?
  at        DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author  User     @relation(fields: [authorId], references: [id])
  topic   Topic?   @relation(fields: [topicId], references: [id])
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([orgId, at])
}
